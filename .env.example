# Copiar a .env y completar con valores reales — nunca commitear .env
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cognion
SECRET_KEY=cambiar-por-un-secreto-seguro
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Adaptador SMTP propio de BC Identidad (ADR-012) — envío de invitaciones
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-responder@cognion.local

# Orígenes CORS permitidos, separados por coma (no admite '*') — ADR-024
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Entorno: desarrollo (default) | local | staging | produccion — US-8.1.3, US-8.5.1
# local: para correr en tu máquina y exponerlo a la red del aula. Valida SOLO el secreto (SECRET_KEY >=32
# chars, no el ejemplo); permite localhost/IP en base, SMTP, FRONTEND_URL y CORS.
# En staging/produccion la app NO arranca si SECRET_KEY (>=32 chars, no el ejemplo), DATABASE_URL,
# SMTP_HOST/SMTP_FROM, FRONTEND_URL o CORS_ALLOWED_ORIGINS conservan valores de desarrollo.
ENTORNO=desarrollo

# Modo de envío de email — US-8.5.2: smtp (default) | consola
# consola: no abre conexión SMTP; escribe destinatario, asunto y cuerpo (con los links de token) en el log INFO.
# Para correr sin servidor de correo (recuperar contraseña, invitaciones). Se rechaza en staging/produccion.
EMAIL_MODO=smtp

# Cuentas SMTP por materia (ADR-023, US-8.1.7): JSON {"<materia_id>": {...}}. Las materias que no figuran
# (y los emails sin materia, como la recuperación de contraseña) salen por la cuenta global SMTP_* de arriba.
# En producción se carga como secret: fly secrets set SMTP_CUENTAS_POR_MATERIA='{...}'. El materia_id se ve
# en GET /api/materias (rol Administrador). Cada cuenta: host, remitente (obligatorios), port (25), user, password.
# SMTP_CUENTAS_POR_MATERIA={"<uuid-materia>": {"host": "smtp.ejemplo.edu.ar", "port": 587, "user": "gestion", "password": "...", "remitente": "materia@ejemplo.edu.ar"}}
