# Plantilla de configuración del servidor (US-10.2.2). NO poner valores reales acá.
# `preparar-env.sh <dominio>` (o `--sin-dominio <ip-o-nombre>`) genera el `.env` real con secretos aleatorios y
# permisos 600. Los valores entre guiones bajos dobles son marcadores que reemplaza ese script.

# Dirección por la que se accede: un dominio (HTTPS automático de Caddy) o `:80` (sin dominio, solo HTTP)
COGNION_DOMINIO=__DOMINIO__
# Imagen de la aplicación; la publica el CD al crear una etiqueta vX.Y.Z (misma versión que el paquete)
COGNION_IMAGE=__IMAGEN__

# Entorno y emails: sin SMTP, los emails quedan en el log y los links de recuperar contraseña se leen ahí.
# Para enviar emails reales NO editar acá: usar `./cognion.sh email` (pide la contraseña de aplicación sin eco y
# agrega SMTP_* a este .env). Con ENTORNO=produccion la aplicación exige SMTP configurado y no arranca en modo consola.
ENTORNO=local
EMAIL_MODO=consola

# Secretos: aleatorios y propios de este servidor
SECRET_KEY=__SECRETO__
POSTGRES_PASSWORD=__PASSWORD_DB__
DATABASE_URL=postgresql+asyncpg://cognion:__PASSWORD_DB__@db:5432/cognion

# La aplicación y la API comparten origen
FRONTEND_URL=__URL__
CORS_ALLOWED_ORIGINS=__URL__

# Formato de los logs: texto (por defecto) o json, una línea JSON por registro para herramientas.
# LOG_FORMAT=json

# Memoria máxima de cada contenedor (por defecto 1g) y puertos que publica Caddy (por defecto 80 y 443).
# Cambiar los puertos exige ajustar también FRONTEND_URL y CORS_ALLOWED_ORIGINS (con el puerto) y, con dominio, que el
# DNS y el firewall lleguen a esos puertos.
# COGNION_MEM_DB=1g
# COGNION_MEM_APP=1g
# COGNION_HTTP_PORT=80
# COGNION_HTTPS_PORT=443
