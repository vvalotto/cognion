# Plantilla de configuración de la VM (US-8.6.2, ADR-025). NO poner valores reales acá.
# `preparar-env.sh <dominio>` genera el `.env` real con secretos aleatorios y permisos 600.
# Los valores entre guiones bajos dobles son marcadores que reemplaza ese script.

# Dominio público de DuckDNS, sin esquema (ej. cognion.duckdns.org)
COGNION_DOMINIO=__DOMINIO__
# Imagen de la aplicación; la publica CI al crear una etiqueta (US-8.6.4)
COGNION_IMAGE=cognion:latest

# Entorno y emails (ADR-025, decisión 2): sin SMTP, los emails quedan en el log
ENTORNO=local
EMAIL_MODO=consola

# Secretos: aleatorios y propios de esta VM
SECRET_KEY=__SECRETO__
POSTGRES_PASSWORD=__PASSWORD_DB__
DATABASE_URL=postgresql+asyncpg://cognion:__PASSWORD_DB__@db:5432/cognion

# La aplicación y la API comparten origen (US-8.1.6)
FRONTEND_URL=https://__DOMINIO__
CORS_ALLOWED_ORIGINS=https://__DOMINIO__
