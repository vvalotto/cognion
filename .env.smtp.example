# Cuenta SMTP de Cognión con Gmail (ADR-023). Copiar a `.env.smtp` (ignorado por git) y completar.
#   cp .env.smtp.example .env.smtp && chmod 600 .env.smtp
# La contraseña NO es la clave de la cuenta: es una "contraseña de aplicación" de 16 caracteres.
# Requiere verificación en 2 pasos y se genera en https://myaccount.google.com/apppasswords
# Gmail solo envía como la cuenta autenticada: SMTP_FROM debe ser esa misma dirección.

SMTP_HOST=smtp.gmail.com
# El código solo implementa STARTTLS: puerto 587 (no 465, que es SSL directo).
SMTP_PORT=587
SMTP_USER=tu.cuenta@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=tu.cuenta@gmail.com
